<header class="w-full bg-black py-16 sm:py-20 px-4 mb-12 border-b border-neutral-900 shadow-xl flex flex-col items-center justify-center text-center">
    <span class="text-[9px] tracking-[0.3em] uppercase text-neutral-500 font-mono mb-3 block">
        Acquisitions Department
    </span>
    <h1 class="text-4xl sm:text-5xl font-normal tracking-wide text-white uppercase" style="font-family: 'Times New Roman', Times, Baskerville, Georgia, serif;">
        Sell Your Vehicle
    </h1>
    <div class="w-12 h-[1px] bg-[#DC2626] mt-5"></div>
</header>

<main class="max-w-4xl mx-auto px-4 sm:px-6 pb-24">
    
    <section class="mb-12 text-center max-w-xl mx-auto space-y-3">
        <h2 class="text-xs font-mono tracking-widest text-neutral-400 uppercase">Premium Vehicle Consignment Matrix</h2>
        <p class="text-xs text-neutral-500 leading-relaxed">
            Provide the precise technical specifications and physical metrics of your automotive platform below. Our portfolio acquisitions desk will analyze the data entry points immediately.
        </p>
    </section>

    <% if (locals.errors) { %>
        <div class="bg-red-950/40 border border-red-900 rounded-xl p-4 mb-6">
            <ul class="list-disc list-inside space-y-1 text-xs text-red-400 font-mono">
                <% errors.forEach(function (error) { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="/inv/sell" method="POST" enctype="multipart/form-data" class="bg-[#0D0D0D] border border-neutral-900 rounded-2xl p-6 sm:p-10 space-y-8 shadow-2xl">
        
        <div>
            <h3 class="text-[10px] font-mono tracking-widest text-red-500 uppercase border-b border-neutral-900 pb-2 mb-6">
                01. Core Identity Matrix
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="flex flex-col space-y-2">
                    <label for="inv_make" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Manufacturer (Make)</label>
                    <input type="text" id="inv_make" name="inv_make" value="<%= locals.inv_make || '' %>" placeholder="e.g., Aston Martin" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>

                <div class="flex flex-col space-y-2">
                    <label for="inv_model" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Vehicle Model</label>
                    <input type="text" id="inv_model" name="inv_model" value="<%= locals.inv_model || '' %>" placeholder="e.g., DBS Superleggera" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>

                <div class="flex flex-col space-y-2">
                    <label for="inv_year" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Model Year</label>
                    <input type="number" id="inv_year" name="inv_year" value="<%= locals.inv_year || '' %>" placeholder="2026" min="1900" max="2030" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-[10px] font-mono tracking-widest text-red-500 uppercase border-b border-neutral-900 pb-2 mb-6">
                02. Technical Metrics & Category
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col space-y-2">
                    <label for="inv_miles" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Odometer Mileage</label>
                    <input type="number" id="inv_miles" name="inv_miles" value="<%= locals.inv_miles || '' %>" placeholder="e.g., 2800" min="0" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>

                <div class="flex flex-col space-y-2">
                    <label for="inv_color" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Exterior Color Finish</label>
                    <input type="text" id="inv_color" name="inv_color" value="<%= locals.inv_color || '' %>" placeholder="e.g., Satin Onyx Black" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>

                <div class="flex flex-col space-y-2">
                    <label for="inv_price" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Expected Value / Price (USD)</label>
                    <input type="number" id="inv_price" name="inv_price" value="<%= locals.inv_price || '' %>" placeholder="e.g., 315000" min="0" required
                        class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors">
                </div>

                <div class="flex flex-col space-y-2">
                    <label for="classification_id" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Vault Classification Group</label>
                    <div class="relative">
                        <select id="classification_id" name="classification_id" required
                            class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-3 rounded-xl focus:outline-none transition-colors appearance-none cursor-pointer">
                            <option value="" disabled <%= !locals.classification_id ? 'selected' : '' %> class="text-neutral-600">Select Structural Classification</option>
                            <% classifications.forEach(function(classification) { %>
                                <option value="<%= classification.classification_id %>" <%= locals.classification_id == classification.classification_id ? 'selected' : '' %> class="bg-neutral-950 text-white">
                                    <%= classification.classification_name %>
                                </option>
                            <% }) %>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-neutral-500">
                            <svg class="fill-current h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-[10px] font-mono tracking-widest text-red-500 uppercase border-b border-neutral-900 pb-2 mb-6">
                03. Imagery Asset Upload
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-5 gap-6 items-start">
                <div class="md:col-span-3 flex flex-col space-y-2">
                    <label for="inv_image" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">High-Resolution Exterior Profile Media</label>
                    <div class="group relative w-full bg-neutral-950 border border-dashed border-neutral-900 hover:border-neutral-700 rounded-xl p-6 text-center transition-colors duration-200">
                        <input type="file" id="inv_image" name="inv_image" accept="image/*" required
                            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                        <div class="space-y-2">
                            <svg class="mx-auto h-6 w-6 text-neutral-600 group-hover:text-neutral-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H4a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <p id="upload-status-text" class="text-xs text-neutral-400 transition-colors">Click or drag your asset file here to upload to Imagery</p>
                            <p class="text-[10px] text-neutral-600 font-mono">PNG, JPG, WEBP up to 10MB</p>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2 flex flex-col space-y-2">
                    <span class="text-[10px] font-mono tracking-wider uppercase text-neutral-500">Asset Display Verification</span>
                    <div id="preview-wrapper" class="relative aspect-[16/10] bg-neutral-950 border border-neutral-900 rounded-xl overflow-hidden flex items-center justify-center transition-all duration-300">
                        <div id="preview-placeholder" class="text-center p-4">
                            <i class="fa-solid fa-camera text-neutral-800 text-xl mb-1 block"></i>
                            <span class="text-[9px] font-mono text-neutral-600 uppercase tracking-widest">Awaiting Media</span>
                        </div>
                        <img id="ui-preview-blur" src="" alt="" class="hidden absolute inset-0 w-full h-full object-cover opacity-20 blur-xl scale-110 pointer-events-none">
                        <img id="ui-preview-img" src="" alt="Consignment Asset View" class="hidden relative w-full h-full object-cover scale-[0.98] rounded-lg transition-transform duration-500">
                    </div>
                </div>
            </div>
        </div>

        <div>
            <h3 class="text-[10px] font-mono tracking-widest text-red-500 uppercase border-b border-neutral-900 pb-2 mb-6">
                04. Complete History Documentation
            </h3>
            
            <div class="flex flex-col space-y-2">
                <label for="inv_description" class="text-[10px] font-mono tracking-wider uppercase text-neutral-400">Comprehensive Vehicle Narrative / History</label>
                <textarea id="inv_description" name="inv_description" rows="5" required 
                    placeholder="Describe optional tracking packages, condition reports, performance specs or distinct history profiles..."
                    class="w-full bg-neutral-950 border border-neutral-900 focus:border-neutral-700 text-white font-mono text-xs p-4 rounded-xl focus:outline-none transition-colors resize-none"><%= locals.inv_description || '' %></textarea>
            </div>
        </div>

        <div class="pt-4 text-center">
            <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-[var(--secondary)] hover:bg-red-800 text-white text-[10px] font-bold uppercase tracking-[0.2em] rounded-xl shadow-xl transition-all duration-300 transform hover:-translate-y-0.5">
                Submit Vehicle to Valuation Vault
            </button>
        </div>

    </form>
</main>
<script src="../../js/sell-vehicles.js?v=1.0.1" defer></script>