<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* Performance-safe transitions using GPU acceleration */
    .card-animate {
        will-change: transform, box-shadow;
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>

<div class="w-full">
    
    <section class="w-full overflow-hidden shadow-md mb-12 border ">
        <div class="h-56 sm:h-72 w-full bg-neutral-900 relative overflow-hidden">
            <% if (cars && cars.length > 0) { %>
                <img src="<%= cars[0].inv_image %>" alt="<%= brandName %> Showroom" class="w-full h-full object-cover">
            <% } else { %>
                <div class="w-full h-full bg-gradient-to-r from-neutral-800 to-neutral-950"></div>
            <% } %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        </div>

        <div class="bg-primary border-t-2 border-gray-500 text-white px-6 py-6 relative flex flex-col md:flex-row items-center md:items-end justify-between">
            
            <div class="flex flex-col md:flex-row items-center text-center md:text-left md:space-x-6 -mt-20 md:-mt-24 z-10 w-full md:w-auto">
                <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full bg-[var(--primary)] p-1.5 shadow-2xl border-4 border-gray-500 flex items-center justify-center overflow-hidden shrink-0">
                    <img src="/images/brand-icon/<%= brandName.trim().toLowerCase() %>-tn.webp" alt="<%= brandName %> Branding" class="max-w-[85%] max-h-[85%] object-contain ">
                </div>

                <div class="mt-4 md:mt-0 pt-2">
                    <h1 class="text-3xl sm:text-4xl font-black tracking-tight uppercase"><%= brandName %></h1>
                    <p class="text-xs sm:text-sm font-bold tracking-widest text-secondary uppercase mt-0.5">Performance Redefined</p>
                    <p class="text-xs text-neutral-400 font-mono mt-2">
                        <i class="fa-solid fa-car-side text-secondary mr-1.5"></i> <%= cars.length %> Unique ride available
                    </p>
                </div>
            </div>

            <div class="flex items-center space-x-4 mt-6 md:mt-0 pt-2 border-t border-neutral-800 md:border-none w-full md:w-auto justify-center">
                <a href="#" class="w-9 h-9 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-secondary hover:border-secondary transition-all duration-200" aria-label="Official Website">
                    <i class="fa-solid fa-globe text-sm"></i>
                </a>
                <a href="#" class="w-9 h-9 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-secondary hover:border-secondary transition-all duration-200" aria-label="Instagram Profile">
                    <i class="fa-brands fa-instagram text-sm"></i>
                </a>
                <a href="#" class="w-9 h-9 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-secondary hover:border-secondary transition-all duration-200" aria-label="YouTube Channel">
                    <i class="fa-brands fa-youtube text-sm"></i>
                </a>
                <a href="#" class="w-9 h-9 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-secondary hover:border-secondary transition-all duration-200" aria-label="X Twitter Feed">
                    <i class="fa-brands fa-x-twitter text-sm"></i>
                </a>
            </div>
        </div>
    </section>


    <% if (cars && cars.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mx-4 md:mx-20 my-15 ">
            <% cars.forEach(function(car) { %>
                <article class="group bg-white border border-neutral-200/80 rounded-xl overflow-hidden shadow-sm hover:shadow-xl card-animate hover:-translate-y-1.5 flex flex-col justify-between relative">
                    
                    <div class="relative aspect-[16/10] bg-neutral-50 overflow-hidden border-b border-neutral-100">
                        <img src="<%= car.inv_image %>" alt="<%= car.inv_make %> <%= car.inv_model %>" class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300 ease-out" loading="lazy">
                        
                        <div class="absolute top-3 left-3 bg-secondary px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider text-white shadow">
                            NEW <%= car.inv_year %>
                        </div>

                        <button 
                            type="button" 
                            class="like-btn absolute top-3 right-3 w-8 h-8 flex items-center justify-center bg-black/60 backdrop-blur-md text-white rounded-full border border-white/10 shadow-md hover:bg-black/80 hover:scale-110 active:scale-95 transition-all duration-200 z-10 cursor-pointer" 
                            data-id="<%= car.inv_id %>"
                            aria-label="Toggle favorite status"
                        >
                            <i class="<%= car.is_favorited ? 'fa-solid text-[var(--secondary)]' : 'fa-regular' %> fa-heart text-xs pointer-events-none transition-colors duration-200"></i>
                        </button>
                    </div>

                    <div class="p-5 flex-1 flex flex-col justify-between">
                        <div class="mb-4">
                            <h2 class="text-lg font-black text-primary tracking-tight uppercase group-hover:text-secondary transition-colors truncate">
                                <%= car.inv_make %> <%= car.inv_model %>
                            </h2>
                            
                            <div class="text-xs text-neutral-500 font-medium mt-1 flex items-center space-x-1 divide-x divide-neutral-300">
                                <span class="pr-1.5"><%= Number(car.inv_miles).toLocaleString() %> miles</span>
                                <span class="pl-1.5"><%= car.inv_color %> Edition</span>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-neutral-100 flex items-center justify-between">
                            <span class="text-lg font-black text-primary">
                                $<%= Number(car.inv_price).toLocaleString() %>
                            </span>
                            <a href="/inv/details/<%= car.inv_id %>" class="px-4 py-2 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded border border-primary hover:bg-white hover:text-primary transition-all duration-200 shadow-sm group-hover:shadow-md">
                                View Details
                            </a>
                        </div>
                    </div>

                </article>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-20 bg-neutral-50 rounded-2xl border-2 border-dashed border-neutral-200">
            <i class="fa-solid fa-circle-exclamation text-4xl text-neutral-300 mb-3"></i>
            <h3 class="text-base font-bold text-primary">No Vehicles Currently Available</h3>
            <p class="text-sm text-neutral-400 mt-1">Check back later or view alternative classifications.</p>
        </div>
    <% } %>

</div>