<!-- Import AOS Animation Subsystem Assets in your main layout head or explicitly here -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<div class="w-full bg-[var(--accent)] text-white antialiased min-h-screen font-sans overflow-x-hidden">
    
    <!-- Outer Layout Frame Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
        
        <!-- TOP GRID AREA: Hero Showcase & Value Proposition Matrix Deck -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
            
            <!-- Hero Left Side Layout Deck Element (7/12 Width Frame) -->
            <section class="lg:col-span-7 bg-neutral-900/50 backdrop-blur-md rounded-3xl p-6 sm:p-10 border border-white/5 shadow-2xl flex flex-col justify-between overflow-hidden relative group min-h-[440px]"
                     data-aos="fade-right" 
                     data-aos-duration="800" 
                     data-aos-easing="ease-out-quad">
                
                <!-- Ambient Backdrop Glow Track Node -->
                <div class="absolute -top-32 -left-32 w-64 h-64 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div class="relative z-10 space-y-4">
                    <span class="text-[15px] font-mono tracking-widest text-red-500 uppercase font-black block">
                        // VELOCITY DRIVES ASSET ACQUISITION
                    </span>
                    <h1 class="text-3xl sm:text-5xl font-black tracking-tighter uppercase leading-none max-w-xl">
                        Turn Your Extraordinary Machine Into <span class="text-gray-500">Liquid Capital</span>
                    </h1>
                </div>

                <!-- Immersive Visual Frame Core Asset Slot -->
                <div class="my-6 relative rounded-2xl overflow-hidden aspect-[16/9] border border-neutral-800 bg-neutral-950">
                    <img src="/images/site/sell-your-call-banner.webp" 
                         alt="Classic high-value vehicle appraisal evaluation inspect sequence showcase" 
                         class="w-full h-full object-cover opacity-85 group-hover:scale-[1.02] transition-transform duration-700 ease-out">
                    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent"></div>
                </div>

                <div class="relative z-10 pt-2">
                    <a href="#cta-execution-deck" class="inline-flex items-center px-6 py-3.5 bg-red-500 text-white text-xs font-black uppercase tracking-widest rounded-xl hover:bg-white hover:text-black transition-all duration-300 shadow-lg group/btn">
                        <span>Initiate Valuation Grid</span>
                        <i class="fa-solid fa-chevron-right ml-2 text-[10px] transform group-hover/btn:translate-x-1 transition-transform"></i>
                    </a>
                </div>
            </section>

            <!-- Value Proposition Right Side Deck Element (5/12 Width Frame) -->
            <section class="lg:col-span-5 bg-neutral-900/40 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/5 flex flex-col justify-between space-y-6"
                     data-aos="fade-left" 
                     data-aos-duration="800" 
                     data-aos-delay="150" 
                     data-aos-easing="ease-out-quad">
                
                <div class="border-b border-neutral-900 pb-3">
                    <h2 class="text-xs font-black uppercase tracking-widest text-neutral-800 flex items-center">
                        <i class="fa-solid fa-gem text-red-500 mr-2 text-[10px]"></i> Value Proposition Deck
                    </h2>
                </div>

                <!-- Row 1: Yield Parameter Feature Node Component -->
                <div class="flex items-start space-x-4 p-4 rounded-2xl bg-neutral-900/50 border border-white/[0.02] transition-colors hover:bg-neutral-900/80">
                    <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0 shadow-inner">
                        <i class="fa-solid fa-chart-line text-sm"></i>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-xs font-black uppercase tracking-wider text-white">1. Maximum Yield Tag</h3>
                        <p class="text-xs text-neutral-300 leading-relaxed font-normal">
                            We deploy advanced multi-channel tracking to match or completely beat verified written offers.
                        </p>
                    </div>
                </div>

                <!-- Row 2: Processing Delta Feature Node Component -->
                <div class="flex items-start space-x-4 p-4 rounded-2xl bg-neutral-900/50 border border-white/[0.02] transition-colors hover:bg-neutral-900/80">
                    <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0 shadow-inner">
                        <i class="fa-solid fa-stopwatch-20 text-sm"></i>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-xs font-black uppercase tracking-wider text-white">2. Rapid Processing</h3>
                        <p class="text-xs text-neutral-300 leading-relaxed font-normal">
                            Liquidation pipelines clear securely. Escrow wire transfers hit your routing destination track within 48 business hours.
                        </p>
                    </div>
                </div>

                <!-- Row 3: Fee Schedule Transparency Feature Node Component -->
                <div class="flex items-start space-x-4 p-4 rounded-2xl bg-neutral-900/50 border border-white/[0.02] transition-colors hover:bg-neutral-900/80">
                    <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0 shadow-inner">
                        <i class="fa-solid fa-receipt text-sm"></i>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-xs font-black uppercase tracking-wider text-white">3. Zero Hidden Fees</h3>
                        <p class="text-xs text-neutral-300 leading-relaxed font-normal">
                            Completely transparent cataloging, state-level documentation changes, and logistics tracking management.
                        </p>
                    </div>
                </div>
            </section>
        </div>

        <!-- LOWER GRID AREA: 3-Step Process Ledger Loop & Smart CTA Form Engine Block -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
            
            <!-- Process Step Path Timeline Matrix Grid Layout (7/12 Width Frame) -->
            <section class="lg:col-span-7 bg-neutral-900/40 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border border-white/5 flex flex-col justify-between space-y-6"
                     data-aos="fade-up" 
                     data-aos-duration="800" 
                     data-aos-easing="ease-out-quad">
                
                <div class="border-b border-neutral-900 pb-3">
                    <h2 class="text-xs font-black uppercase tracking-widest text-neutral-700 flex items-center">
                        <i class="fa-solid fa-gears text-red-500 mr-2 text-[10px]"></i> 3-Step Process Matrix
                    </h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <!-- Step Card 1 Component Frame Area -->
                    <div class="p-5 bg-neutral-900/40 rounded-2xl border border-white/5 flex flex-col space-y-4 hover:border-neutral-800 transition-colors"
                         data-aos="zoom-in-up" data-aos-delay="100" data-aos-duration="600" data-aos-anchor-placement="top-bottom">
                        <div class="flex justify-between items-center">
                            <span class="text-[9px] font-mono font-black text-neutral-300 bg-neutral-950 px-2 py-0.5 rounded border border-white/5">STEP_01</span>
                            <i class="fa-solid fa-file-invoice text-red-500/80 text-sm"></i>
                        </div>
                        <div class="space-y-1.5">
                            <h4 class="text-xs font-black uppercase tracking-tight text-white">Submit Specifications</h4>
                            <p class="text-[11px] text-neutral-300 leading-relaxed font-normal">Input your vehicle details, mechanical mileage logging indexes, and high-res asset imagery snapshots.</p>
                        </div>
                    </div>

                    <!-- Step Card 2 Component Frame Area -->
                    <div class="p-5 bg-neutral-900/40 rounded-2xl border border-white/5 flex flex-col space-y-4 hover:border-neutral-800 transition-colors"
                         data-aos="zoom-in-up" data-aos-delay="200" data-aos-duration="600" data-aos-anchor-placement="top-bottom">
                        <div class="flex justify-between items-center">
                            <span class="text-[9px] font-mono font-black text-neutral-300 bg-neutral-950 px-2 py-0.5 rounded border border-white/5">STEP_02</span>
                            <i class="fa-solid fa-magnifying-glass-chart text-red-500/80 text-sm"></i>
                        </div>
                        <div class="space-y-1.5">
                            <h4 class="text-xs font-black uppercase tracking-tight text-white">Expert Appraisal</h4>
                            <p class="text-[11px] text-neutral-300 leading-relaxed font-normal">Our global review network validates asset condition tags against live programmatic auction valuation matrices.</p>
                        </div>
                    </div>

                    <!-- Step Card 3 Component Frame Area -->
                    <div class="p-5 bg-neutral-900/40 rounded-2xl border border-white/5 flex flex-col space-y-4 hover:border-neutral-800 transition-colors"
                         data-aos="zoom-in-up" data-aos-delay="300" data-aos-duration="600" data-aos-anchor-placement="top-bottom">
                        <div class="flex justify-between items-center">
                            <span class="text-[9px] font-mono font-black text-neutral-300 bg-neutral-950 px-2 py-0.5 rounded border border-white/5">STEP_03</span>
                            <i class="fa-solid fa-handshake-angle text-red-500/80 text-sm"></i>
                        </div>
                        <div class="space-y-1.5">
                            <h4 class="text-xs font-black uppercase tracking-tight text-white">Secure Execution</h4>
                            <p class="text-[11px] text-neutral-300 leading-relaxed font-normal">Finalize the digital acquisition buyout ledger contracts and initiate immediate rapid bank wire execution patterns.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Dynamic Smart Authentication Gate / CTA Segment Frame Block (5/12 Width Frame) -->
            <section id="cta-execution-deck" class="lg:col-span-5 bg-neutral-900/40 backdrop-blur-md rounded-3xl p-6 sm:p-8 border border-white/5 shadow-2xl flex flex-col justify-between relative overflow-hidden min-h-[300px]"
                     data-aos="fade-up" 
                     data-aos-duration="800" 
                     data-aos-delay="200"
                     data-aos-easing="ease-out-quad">
                     
                <!-- High-contrast Accent Glow Container Element Track Base -->
                <div class="absolute -bottom-32 -right-32 w-64 h-64 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div class="border-b border-neutral-900/80 pb-3 relative z-10">
                    <h2 class="text-xs font-black uppercase tracking-widest text-neutral-700 flex items-center">
                        <i class="fa-solid fa-shield-halved text-red-500 mr-2 text-[10px]"></i> Our Secure Engagement Gate
                    </h2>
                </div>

                <div class="my-auto py-4 space-y-3 relative z-10">
                    <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight leading-none">
                        Secure the Highest <span class="text-red-500">Value Now</span>
                    </h3>
                    <p class="text-xs text-neutral-400 leading-relaxed font-normal max-w-sm">
                        To guarantee platform validation parameters match identity ownership matrices, an authorized credentials check tracking link sequence must be verified.
                    </p>
                </div>

                <div class="relative z-10 pt-2 w-full">
                    <% if (locals.user) { %>
                        <!-- CONDITIONAL PATH A: User Session is Valid / Authenticated -->
                        <div class="space-y-3 w-full">
                            <div class="flex items-center space-x-2 text-[11px] font-mono text-green-400 bg-green-500/5 border border-green-500/10 p-3 rounded-xl">
                                <i class="fa-solid fa-circle-check animate-pulse"></i>
                                <span>Session Signature Authenticated. System track completely clear.</span>
                            </div>
                            <a href="/sell/form" class="w-full text-center inline-block py-4 bg-red-500 hover:bg-white hover:text-black text-white text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 shadow-md">
                                Access Asset Specification Form Engine
                            </a>
                        </div>
                    <% } else { %>
                        <!-- CONDITIONAL PATH B: Guest Mode / Route Track to Authentication with Redirect Logic Target -->
                        <div class="space-y-4 w-full">
                            <a href="/account/login?redirect=/sell/form" class="w-full text-center inline-block py-4 bg-red-500 hover:bg-white hover:text-black text-white text-xs font-black uppercase tracking-widest rounded-xl transition-all duration-300 shadow-lg font-bold">
                                Sign In to Unlock Vehicle Asset Form Track
                            </a>
                            <div class="text-center">
                                <p class="text-[9px] font-mono text-neutral-200 uppercase tracking-wider">
                                    * System authentication requirements protect active data ledger structures.
                                </p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
        
    </main>
</div>

<!-- AOS Core Execution Script Engine Layer -->
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        AOS.init({
            once: true, // Only trigger animation sequences the first time elements enter the frame
            mirror: false // Prevents repeating the animations when scrolling back up
        });
    });
</script>