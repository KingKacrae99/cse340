<section class="login-container">
  <div class="login-card animate-fade-in">
    
    <div class="card-header">
      <h1 class="brand-title font-family-merriweather">CSE340 Motors </h1>
      <p class="brand-tagline">Unlock Your Journey</p>
      <h2 class="form-intent-title"><%= title %></h2>
      <p class="form-intent-subtitle">Sign in to access your digital garage and services.</p>
    </div>

    <% if (locals.messages) { %>
      <div class="flash-messages-matrix">
        <%- messages() %>
      </div>
    <% } %>

    <form method="post" action="/account/login" id="login-form" class="auth-form-matrix">
      
      <div class="form-field-group">
        <label for="account_email" class="field-label">Email Address</label>
        <div class="input-context-wrapper">
          <input 
            type="email" 
            id="account_email" 
            name="account_email" 
            required 
            placeholder="Enter your email" 
            class="form-input-element"
            value="<%= locals.account_email ? account_email : '' %>"
          >
        </div>
      </div>

      <div class="form-field-group">
        <div class="label-row-split">
          <label for="account_password" class="field-label">Password</label>
          <span class="forgot-password-link">Forgot Password?</span>
        </div>
        
        <div class="input-context-wrapper">
          <input 
            type="password" 
            id="account_password" 
            name="account_password" 
            autocomplete="current-password"
            pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
            required 
            placeholder="Enter your password"
            class="form-input-element"
          >
        </div>
        
        <div class="password-complexity-compliance-deck">
          <p>Complexity Blueprint: Minimum 12 characters, including 1 uppercase, 1 numeric digit, and 1 special matrix character.</p>
        </div>
      </div>

      <div class="form-options-row">
        <label class="custom-checkbox-container">
          <input type="checkbox" name="remember_me" id="remember_me">
          <span class="checkbox-label-text">Remember Me</span>
        </label>
      </div>

      <div class="form-action-trigger-deck">
        <button type="submit" id="login-btn" class="primary-submit-btn">Log In</button>
      </div>

      <div class="card-footer-redirection">
        <p class="no-account-notice">
          Don't have an account? 
          <a href="/account/registration" class="registration-highlight-link">Sign Up</a>
        </p>
      </div>
      
    </form>
  </div>
</section>