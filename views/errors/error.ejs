<div class="flex flex-col items-center justify-center min-h-[90vh] w-full bg-cover bg-center bg-no-repeat relative overflow-hidden px-6 py-12 text-white shadow-2xl"
     style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.7), rgba(0,0,0,0.5)), url('/images/site/bg-error.webp');"
     data-aos="zoom-in" 
     data-aos-duration="600">
    
    <!-- Outer ambient dark overlay anchor track -->
    <div class="relative z-10 text-center max-w-3xl md:max-w-4xl mx-auto space-y-8">
        
        <!-- Main Accent Header Node -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tighter drop-shadow-[0_2px_4px_rgba(255,255,255,0.15)] leading-none text-white">
            💥 Boom! Your flight ✈ just crashed.
        </h1>

        <!-- Contextual Message Ledger Area -->
        <section class="space-y-5 font-serif">
            <h2 class="text-xl sm:text-3xl font-bold uppercase tracking-wide font-merriweather">
                <%= title %> | Error
            </h2>
            <p class="text-base sm:text-lg text-neutral-300 max-w-md mx-auto leading-relaxed font-sans font-light">
                <%= message %>
            </p>
        </section>

        <!-- CTA Back-channel Router Trigger Navigation Node -->
        <div class="pt-4">
            <a href="/" class="inline-block px-6 py-3.5 bg-red-500 hover:bg-white text-white hover:text-black text-xs font-black uppercase tracking-widest rounded-xl border border-red-500 hover:border-white transition-all duration-300 shadow-lg active:scale-95">
                Go Back Home
            </a>
        </div>
        
    </div>
</div>